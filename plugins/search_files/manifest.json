{
  "name": "search_files",
  "description": "Search text files inside the AgentDemo workspace.",
  "permission": "read",
  "requires_confirmation": false,
  "parameters": {
    "type": "object",
    "required": ["query"],
    "additionalProperties": false,
    "properties": {
      "query": { "type": "string" },
      "path": { "type": "string", "format": "path" },
      "max_results": { "type": "integer" }
    }
  },
  "timeout_seconds": 20,
  "output_strategy": { "max_chars": 8000 },
  "entrypoint": "tool.py:run",
  "enabled": true
}
