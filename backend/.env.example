APP_NAME=Personal Agent
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_demo
CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGIN_REGEX=https?://.*
AGENT_ACCESS_TOKEN=
PLUGIN_DIR=../plugins
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.moleapi.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
# LLM_API_KEY takes precedence; DeepSeek retains DEEPSEEK_API_KEY compatibility.
LLM_API_KEY=
# Set false only for a deliberately configured keyless local model server.
LLM_API_KEY_REQUIRED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-v4-pro
TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_OUTPUT_CHARS=8000
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=4096
LLM_OUTPUT_TOKEN_PARAMETER=max_tokens
# Optional provider-supported reasoning effort; omit for temperature-based sampling.
# LLM_REASONING_EFFORT=low
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_RETRIEVAL_TIMEOUT_SECONDS=12
# Character budget for request, recent history and supplemental context (not token count).
AGENT_CONTEXT_MAX_CHARS=48000
AGENT_APPROVAL_TTL_SECONDS=86400
AGENT_TASK_MAX_CONCURRENCY=2
AGENT_TASK_DEFAULT_MAX_ATTEMPTS=3
AGENT_TASK_RETRY_BASE_SECONDS=5
AGENT_TASK_LEASE_SECONDS=180
AGENT_TASK_HEARTBEAT_SECONDS=15
TASK_SCHEDULE_POLL_SECONDS=5
WEB_SEARCH_PROVIDER=disabled
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
