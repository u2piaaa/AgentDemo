{
  "servers": {
    "fetch": {
      "enabled": true,
      "transport": "stdio",
      "protocol_mode": "legacy",
      "command": "mcp\\fetch\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "mcp_server_fetch"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "github": {
      "enabled": true,
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLSETS",
        "-e",
        "GITHUB_TOOLS",
        "-e",
        "GITHUB_READ_ONLY",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "GITHUB_TOOLSETS": "context,repos",
        "GITHUB_TOOLS": "get_file_contents",
        "GITHUB_READ_ONLY": "1"
      }
    },
    "huggingface": {
      "enabled": false,
      "transport": "http",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer ${HUGGINGFACE_TOKEN}"
      }
    }
  }
}
