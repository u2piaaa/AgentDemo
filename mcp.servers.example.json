{
  "servers": {
    "fetch": {
      "enabled": true,
      "transport": "stdio",
      "command": "backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "mcp_server_fetch",
        "--ignore-robots-txt"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "github": {
      "enabled": false,
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
